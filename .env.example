# Copie para .env e preencha. Nunca faça commit do .env.
# Use só letras e números nas senhas (elas entram em URLs de conexão).

# Domínio que o Caddy vai servir. "localhost" para testar na sua máquina.
DOMAIN=localhost

# Login da interface do Airflow.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# Senha do banco "airflow" (metadados do Airflow).
AIRFLOW_DB_PASSWORD=

# Uma senha por projeto em projects/<nome>/: <NOME>_DB_PASSWORD.
# O serviço db-init cria o banco e o usuário <nome> com ela.
BJJ_DB_PASSWORD=

# Tela e API de dados (https://dados.<DOMAIN>).
# Senha do usuário só de leitura que o serviço web usa no banco.
WEB_DB_PASSWORD=
# Quem pode entrar, separados por vírgula: usuario:senha,outro:senha2
WEB_USERS=
# true deixa a tela e a API abertas para qualquer pessoa.
WEB_PUBLIC=false
# Limite de requisições por chave de API (scripts/api-keys.sh).
WEB_RATE_LIMIT_PER_MINUTE=60
WEB_RATE_LIMIT_PER_DAY=5000

# Kafka UI (https://kafka.<DOMAIN>).
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=
# false: a DAG só publica no Kafka e deixa a gravação no banco para um consumidor.
CRAWLER_WRITE_DB=true

# Gere com: openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=
# Gere com: openssl rand -hex 32
AIRFLOW_JWT_SECRET=
